{
  "name": "mini-nest",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "build:naive": "docker build -f Dockerfile.naive -t docker-node-api:naive .",
    "build:docker": "docker build -t docker-node-api:prod .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "6.x"
  }
}
