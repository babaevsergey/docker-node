{
  "name": "mini-nest",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node --enable-source-maps dist/src/server.js",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "build:naive": "docker build -f Dockerfile.naive -t docker-node-api:naive .",
    "build:docker": "docker build -t docker-node-api:prod .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "6.x"
  }
}
